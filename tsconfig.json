{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "bundler",
    "target": "es2022",
    "types": ["node", "jest"],

    /* Soporte para Migración Progresiva (JS + TS) */
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    /* Previene la sobreescritura de archivos .js */
    "outDir": "./dist",
    "noEmit": true,

    "verbatimModuleSyntax": false,
    "isolatedModules": false,

    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*",
    "tests/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.config.cjs",
    "**/*.config.js"
  ]
}