{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "es2022",
    "types": ["node", "jest"],

    /* Soporte para Migración Progresiva (JS + TS) */
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    /* Previene la sobreescritura de archivos .js */
    "outDir": "./dist",
    "rootDir": "./src",
    "noEmit": false,

    "verbatimModuleSyntax": false,
    "isolatedModules": false,

    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests/**/*",
    "**/*.test.ts",
    "**/*.config.cjs",
    "**/*.config.js"
  ]
}