{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "es2022",
    "types": ["node", "jest"],

    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "outDir": "./dist",
    "rootDir": "./",
    "noEmit": false,

    "verbatimModuleSyntax": false,
    "isolatedModules": false,

    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true
  }
}
