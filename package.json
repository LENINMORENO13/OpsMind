{
  "name": "monitor-ia",
  "version": "2.6.0",
  "type": "module",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:frontend": "npm --prefix frontend install && npm --prefix frontend run build",
    "build:all": "npm run build && npm run build:frontend",
    "start": "node dist/app.js",
    "dev": "tsx watch src/app.ts",
    "test": "cross-env NODE_ENV=test jest --detectOpenHandles --forceExit",
    "test:coverage": "cross-env NODE_ENV=test jest --detectOpenHandles --coverage",
    "typecheck": "tsc -p tsconfig.test.json",
    "typecheck:build": "tsc -p tsconfig.build.json --noEmit"
  },
  "keywords": [
    "monitoring",
    "observability",
    "incident-management",
    "sre",
    "ai",
    "gemini",
    "express",
    "prisma",
    "postgresql"
  ],
  "author": "Lenin Moreno <mlenin922@gmail.com> (https://github.com/LENINMORENO13)",
  "license": "MIT",
  "description": "OpsMind — microservice monitoring and AI-assisted incident analysis (Express + TypeScript + Prisma + PostgreSQL + React).",
  "homepage": "https://github.com/LENINMORENO13/OpsMind#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LENINMORENO13/OpsMind.git"
  },
  "bugs": {
    "url": "https://github.com/LENINMORENO13/OpsMind/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "mysql2": "^3.24.5",
    "deepmerge-ts": "^8.0.2"
  },
  "dependencies": {
    "@google/genai": "^2.7.0",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "axios": "^1.13.6",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.2.1",
    "pg": "^8.20.0",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "prisma": "^7.6.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.2"
  }
}
