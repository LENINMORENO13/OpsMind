# Servidor Express
PORT=3000

# Autenticación JWT (usa un secreto largo, aleatorio y único por entorno)
JWT_SECRET=tu_secreto_jwt_aqui

# Credenciales de PostgreSQL para Docker Compose
# POSTGRES_PASSWORD es obligatoria para `docker compose up` (no tiene valor por defecto)
POSTGRES_USER=tu_usuario_db
POSTGRES_PASSWORD=tu_password_db_aqui
POSTGRES_DB=opsmind_db

# Conexión a la Base de Datos (Prisma)
DATABASE_URL="postgresql://tu_usuario_db:tu_password_db_aqui@localhost:5433/opsmind_db?schema=public"
DIRECT_URL="postgresql://tu_usuario_db:tu_password_db_aqui@localhost:5433/opsmind_db?schema=public"

# Base de datos aislada para pruebas (Jest, NODE_ENV=test)
TEST_DATABASE_URL="postgresql://tu_usuario_db:tu_password_db_aqui@localhost:5433/opsmind_test?schema=public"

# Gemini AI (Análisis inteligente de incidentes)
GEMINI_API_KEY=tu_api_key_aqui

# Rate limiting de autenticación (opcional; valores por defecto mostrados)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# Retardo entre reintentos de Gemini en ms (opcional; por defecto 10000)
GEMINI_RETRY_DELAY_MS=10000
