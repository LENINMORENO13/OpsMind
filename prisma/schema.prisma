generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// 1. Definición del Monitor 
model Monitor {
  id            Int           @id @default(autoincrement())
  url           String        @unique
  name          String
  isActive      Boolean       @default(true)
  checkInterval Int           @default(300) // Intervalo en segundos
  lastStatus    ServiceStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relaciones
  logs      Log[]
  incidents Incident[]
}

// 2. Historial de Monitoreo (Para análisis de tendencias)
model Log {
  id           Int           @id @default(autoincrement())
  status       Int // Código HTTP (200, 404, 500, etc.)
  responseTime Int // Tiempo de respuesta en ms
  error        String? // Detalle del error si existe
  trend        TrendStatus   @default(STABLE)
  state        ServiceStatus @default(PENDING)
  timestamp    DateTime      @default(now())

  // Relación con Monitor
  monitorId Int
  monitor   Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)
}

// 3. Capa de Inteligencia
model AIInsight {
  id          Int              @id @default(autoincrement())
  analysis    String           @db.Text // Conclusión de la IA sobre la falla
  suggestion  String?          @db.Text // Recomendación técnica de la IA
  criticality CriticalityLevel
  createdAt   DateTime         @default(now())

  // Relación con Incident
  incidentId Int     @unique
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
}

// 4. Ciclo de Vida del Incidente
model Incident {
   id           Int             @id @default(autoincrement())
   status       IncidentStatus  @default(OPEN)
   startedAt    DateTime        @default(now())
   resolvedAt   DateTime?       // Nulo hasta que el servicio se recupere
   downtime     Int?            // Minutos totales de la caida

   // Relacion a que monitor pertenece
   monitorId    Int
   monitor      Monitor         @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  // Relacion a IAInsights
  aiInsight   AIInsight?

  //Referencia al ResolutionLog
  resolutionLog  ResolutionLog?
}

// 5. Registro de soluciones humanas
model ResolutionLog {
  id          Int      @id @default(autoincrement())
  rootCause   String   @db.Text 
  actionTaken String   @db.Text 
  createdAt   DateTime @default(now())

  // Relación 1 a 1 con el Incidente
  incidentId  Int      @unique
  incident    Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  // Relación con el Usuario que resolvió el incidente
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
}

// 6. Capa de Datos
model User {
   id          Int           @id @default(autoincrement())
   email       String        @unique
   password    String
   createdAt   DateTime      @default(now())
   updatedAt   DateTime      @updatedAt

   //Un usuerio puede registrar multiples resoluciones de incidentes
   resolutions ResolutionLog[]
}

// --- Enums para estandarizar estados ---

enum ServiceStatus {
  UP
  DOWN
  DEGRADED
  PENDING
}

enum TrendStatus {
  RECOVERED
  DROP_DETECTED
  STABLE
  OFFLINE
}

enum CriticalityLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  RESOLVED
  IGNORED
}