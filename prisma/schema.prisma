generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Log {
  id           Int           @id @default(autoincrement())
  url          String
  status       Int
  timestamp    DateTime      @default(now())
  error        String?
  responseTime Int
  trend        TrendStatus   @default(STABLE)
  state        ServiceStatus @default(PENDING)
}

model Monitor {
  id         Int           @id @default(autoincrement())
  url        String        @unique
  name       String
  isActive   Boolean       @default(true)
  createdAt  DateTime      @default(now())
  lastStatus ServiceStatus @default(PENDING)
}

enum ServiceStatus {
  UP
  DOWN
  DEGRADED
  PENDING
}

enum TrendStatus {
  RECOVERED
  DROP_DETECTED
  STABLE
  OFFLINE
}
